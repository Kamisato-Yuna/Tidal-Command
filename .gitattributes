# Normalize source text. Keep code, SVG, JSON/glTF, and lockfiles in regular Git.
* text=auto eol=lf

# Binary source assets are stored in Git LFS. Generated output is gitignored.
*.glb filter=lfs diff=lfs merge=lfs -text
*.fbx filter=lfs diff=lfs merge=lfs -text
*.blend filter=lfs diff=lfs merge=lfs -text
